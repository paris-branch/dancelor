#!/bin/sh

gen_deps () {
    case $1 in
	'')
	    ## Error in the script give up.
	    echo >&2 empty
	    exit 7
	    ;;
	schema*|ctes)
	    ## Supporting files, should not produce a rule.
	    return 1
	    ;;
	migrations)
	    ## Special migration file is built standalone.
	    echo migrations.sql
	    ;;
	*)
	    ## Normal files get built against the schema and the CTEs.
	    echo "schema.sql ctes.sql $1.sql"
	    ;;
    esac
}

gen_rule () {
    ## NOTE: Queries need to type-check against the schema, so we call
    ## `sqlgg` with both, but we disable the DDL category such that no
    ## `CREATE TABLE` or `ALTER TABLE` etc. may take place.
    if deps=$(gen_deps "$1"); then
	cat <<EOF
(rule
 (target $1_sql.ml)
 (deps $deps)
 (action
  (with-stdout-to %{target}
   (run sqlgg -gen caml_io -dialect postgresql %{deps}))))
EOF
    else
	echo ";; supporting file: no Dune rule"
    fi
}

echo ";; This file was generated by $0"
echo

for file in *.sql; do
    echo ";; $file"
    gen_rule "${file%.*}"
    echo
done
